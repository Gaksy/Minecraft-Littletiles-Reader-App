# ===========================================================================
# 应用运行时数据
# ===========================================================================
#
# 应用是便携式的：配置与受管资源默认就在"应用所在目录"下。
# 开发期这个目录就是仓库根，所以这些运行时产物不入库。
# 打包分发时它们会出现在安装目录里，与仓库无关。
#
# config/     app.json：项目登记表、默认输出目录、UI 偏好
# resources/  导入的材质包与模组（可能很大，且含第三方版权内容）
# cache/      组合好的素材包、封面缩略图
# logs/       运行日志

/config/
/resources/
/cache/
/logs/

# 导出的产物（若在仓库里试跑会落在这里）
/outputs/

# 生成端用到的素材与临时目录（与库仓库的约定一致）
#
# data/     素材包（assets）与测试数据（regions / snbt / matlab）。
#           体积大且含第三方贴图；测试数据在兄弟目录 minecraft-littletiles-reader-data，
#           这里只是防止在仓库内试跑时误提交。
# texture/  第三方材质包（版权不明），只在本机使用。
# tmp/      会话级临时目录。
/data/
/texture/
/tmp/

# ===========================================================================
# Python
# ===========================================================================

__pycache__/
*.py[cod]
*.egg
*.egg-info/
build/
dist/

# 测试与静态检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# 虚拟环境（本项目用 conda 环境 minecraft-littletiles-reader）
.venv/
venv/
env/
.python-version

# ===========================================================================
# 打包产物
# ===========================================================================
#
# PyInstaller / Nuitka 的输出；随包分发的库 CLI 由构建脚本从库仓库拷进来，
# 二进制本身不入库。

/release/
/sidecar/
*.spec

# ===========================================================================
# IDE
# ===========================================================================
#
# PyCharm / IntelliJ：整个 .idea/ 不入库。
# 若以后想共享代码风格与检查配置，把它换成下面四行：
#   .idea/*
#   !.idea/codeStyles/
#   !.idea/inspectionProfiles/
#   !.idea/dictionaries/

.idea/
*.iml
.vscode/
*.code-workspace

# ===========================================================================
# 系统
# ===========================================================================

*~
Thumbs.db
desktop.ini
.DS_Store
/app/_buildinfo.py
